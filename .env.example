# Copier ce fichier en .env et remplir avec les valeurs de Project Settings > Data API sur Supabase.
# La clé anon est publique par construction. Ne jamais mettre ici la clé service_role ni la clé Anthropic.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Pendant les tests, sans clé API : le pont local sur le Mac (npm run pont), qui passe par Claude Code
# et l'abonnement Claude de la personne connectée. Adresse affichée au démarrage du pont.
# Quand cette ligne est remplie, elle a la priorité sur Supabase. La laisser vide sinon.
EXPO_PUBLIC_ANALYSE_URL=
